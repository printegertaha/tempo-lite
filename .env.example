# ==============================================================================
# Athar (أثـر) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (for local development) and configure each deployment
# environment independently in your hosting provider's environment settings.
# NEVER commit `.env` or `.env.local` or expose server secrets with NEXT_PUBLIC_.

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Pooled connection string used at runtime by Prisma Pg adapter (e.g. port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string used by Prisma CLI migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional pool size (5 recommended locally, 10 in production)
DATABASE_POOL_MAX="5"

# ------------------------------------------------------------------------------
# 2. Better Auth Core Configuration (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Minimum 32 random characters. Generate with: openssl rand -base64 32
# IMPORTANT: Must remain identical across all production server instances.
BETTER_AUTH_SECRET="replace-with-32-plus-char-random-secret-key"

# Canonical application URL (NO trailing slash):
#   Local development:  http://localhost:3000
#   Production (HTTPS): https://your-production-domain.com
#   Preview / Staging:  https://your-staging-domain.com (do NOT reuse production URL)
BETTER_AUTH_URL="http://localhost:3000"

# Public origin used by SSR / client metadata (must match BETTER_AUTH_URL, never put secrets here)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional comma-separated extra trusted origins (e.g. staging origins)
# BETTER_AUTH_TRUSTED_ORIGINS=""

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Credentials (Server-Side Only — NEVER prefix NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Register these exact URIs in Google Cloud Console > Credentials > Web Client:
#   Authorized JavaScript origins:
#     - http://localhost:3000 (local development)
#     - https://your-production-domain.com (production)
#   Authorized redirect URIs:
#     - http://localhost:3000/api/auth/callback/google (local development)
#     - https://your-production-domain.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# 4. Optional Production Diagnostics Protection Key
# ------------------------------------------------------------------------------
# Optional bearer/header key to allow authorized diagnostic queries to /api/auth/health
# in production without needing an active browser session.
# AUTH_DIAGNOSTICS_KEY=""
